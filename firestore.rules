rules_version = '2';

// Firestore rules for Triplix shared trips.
//
// Paste into Firebase console > Firestore Database > Rules, or deploy with
// `firebase deploy --only firestore:rules`.
//
// The model:
//   - holding the link lets you READ a trip
//   - being in `members` lets you CHANGE THE PLAN
//   - being in `money` lets you RECORD SPENDING
//   - anyone else may ASK for either, and the owner decides each
//
// Two lists rather than one, because they are two different questions. A
// friend helping choose where to eat has no reason to be inside everybody's
// money, and the person settling the bill afterwards has no reason to be able
// to move Day 3. One list meant one approval granted both, and the owner was
// never asked which they meant.
//
// Trips published before `money` existed do not have the field, and all their
// members can record spending today. For those, `members` answers for both --
// see spenders(). Once the field exists it is the only thing consulted.
//
// Self-service joining was the first design and it was wrong twice over.
// Wrong in principle, because a link forwarded on -- to a group chat, to
// somebody's colleague -- would have handed edit rights to whoever opened it.
// And wrong in fact: adding yourself to `members` is an update, and updates
// required membership, so the join could never have succeeded anyway.
//
// Trip ids are 12 random characters from a 33-character alphabet, so they are
// not enumerable in practice. They are still only a secret, not a password:
// anyone the link reaches can read the trip. Nothing sensitive belongs in one.

service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {

      function signedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return signedIn() && resource.data.owner == request.auth.uid;
      }

      function isMember() {
        return signedIn()
          && resource.data.members is list
          && request.auth.uid in resource.data.members;
      }

      // The trip document, for use inside the sub-collections. isOwner() and
      // isMember() above cannot serve there: in a sub-collection `resource`
      // is the expense, not the trip.
      function tripData() {
        return get(/databases/$(database)/documents/trips/$(tripId)).data;
      }

      function tripOwner() {
        return signedIn() && tripData().owner == request.auth.uid;
      }

      // Who may record spending.
      //
      // Falls back to `members` when there is no `money` list at all, so the
      // members of a trip published before this existed keep the access they
      // already had. A trip created now is written with both lists, so the
      // fallback only ever applies to old documents.
      function spenders() {
        return tripData().get('money', tripData().get('members', []));
      }

      // On the trip in any capacity. A photo is not spending and not an
      // itinerary edit, so neither list alone is the right question: somebody
      // approved for either was on the trip and may add a picture of it.
      function tripMemberOrOwner() {
        return signedIn()
          && (tripData().owner == request.auth.uid
              || request.auth.uid in spenders()
              || request.auth.uid in tripData().get('members', []));
      }

      function canSpend() {
        return signedIn()
          && (tripData().owner == request.auth.uid
              || request.auth.uid in spenders());
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // A member editing the trip may not change who owns it, and may not
      // remove anyone -- so a co-traveller cannot take a trip over or lock its
      // author out. They may not quietly promote a pending request either;
      // approving is the owner's decision.
      function memberEdit() {
        return isMember()
          && request.resource.data.owner == resource.data.owner
          && resource.data.members.toSet()
               .difference(request.resource.data.members.toSet()).size() == 0
          // Neither list, and neither queue. An editor cannot let somebody
          // into the ledger any more than into the plan.
          && !changed().hasAny(
               ['members', 'requests', 'profiles', 'money', 'money_requests']);
      }

      // A request carries the asker's name so the owner sees a person rather
      // than a uid to decide about. They may only write their own entry:
      // putting somebody else's name in would let a stranger appear in the
      // approval list as a friend.
      function onlyOwnProfile() {
        return request.resource.data.get('profiles', {})
                 .diff(resource.data.get('profiles', {}))
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      // A visitor asking to help with the plan. Only that queue may change,
      // they must be adding themselves, and they may not drop anyone else's
      // pending request on the way past.
      function asksForTrip() {
        return signedIn()
          && changed().hasOnly(['requests', 'profiles'])
          && request.auth.uid in request.resource.data.requests
          && resource.data.get('requests', []).toSet()
               .difference(request.resource.data.requests.toSet()).size() == 0
          && onlyOwnProfile();
      }

      // The same, for the ledger. A separate queue so the owner approves the
      // two separately -- and so asking for one is never read as asking for
      // both.
      function asksForMoney() {
        return signedIn()
          && changed().hasOnly(['money_requests', 'profiles'])
          && request.auth.uid in request.resource.data.money_requests
          && resource.data.get('money_requests', []).toSet()
               .difference(request.resource.data.money_requests.toSet())
               .size() == 0
          && onlyOwnProfile();
      }

      // Anyone signed in who has the link can read. Sign-in is required so an
      // abusive client cannot scrape anonymously.
      allow get: if signedIn();

      // Never listable. Without this, one query returns every trip in the
      // database and the unguessable id counts for nothing.
      allow list: if false;

      // First write claims the trip, and must claim it honestly.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // The owner may do anything to their own trip, including approving a
      // request or removing someone.
      // Setting your own name on the trip. Separate from asking for access:
      // somebody already approved still needs to be able to say what they are
      // called, and memberEdit deliberately forbids touching profiles so an
      // editor cannot rename anybody else.
      function setsOwnName() {
        return signedIn()
          && changed().hasOnly(['profiles'])
          && request.resource.data.profiles
               .diff(resource.data.get('profiles', {}))
               .affectedKeys().hasOnly([request.auth.uid]);
      }

      allow update: if isOwner() || memberEdit() || asksForTrip()
        || asksForMoney() || setsOwnName();

      allow delete: if isOwner();

      // Suggested changes, waiting on the trip's owner.
      //
      // The trip document is the master copy and only its owner writes to it.
      // Everyone else proposes, and the owner accepts or rejects -- so there is
      // no concurrent write to the plan, no conflict to resolve, and no rule
      // that has to work out which parts of a document a collaborator touched.
      // What people spent, and who paid it.
      //
      // Deliberately not proposals. A change to somebody else's plan needs
      // their agreement; "I paid 800 for the taxi" is a fact about the person
      // writing it, and making them wait for approval to record their own
      // spending would be absurd. So anyone in the trip may add a row, and
      // may only touch their own.
      match /expenses/{expenseId} {

        function paidByCaller() {
          return request.resource.data.by == request.auth.uid;
        }

        allow read: if signedIn();

        // Nobody approves their own money.
        //
        // Membership already limits who can post, but a member's account can
        // be taken over, and an expense that lands straight in the settlement
        // changes what everybody else owes. The owner sees each one first, so
        // a wrong or invented row is caught before it moves any money.
        //
        // The owner's own rows are approved as they are written: waiting for
        // yourself is not a check on anything.

        // Only somebody in the split may add to it.
        //
        // signedIn() alone let anyone holding the link file an expense, while
        // the settlement divides the total between members only -- so their
        // money would be shared out among everybody else and never come back
        // to them. Reading a trip is open; putting money into its accounts is
        // not.
        //
        // Signed with the author's own uid, and a positive amount: a negative
        // expense is a refund, which is a different thing and not one this
        // settles.
        //
        // The owner may also record what somebody else paid, which a member
        // may not. One person usually sits down with the whole group's
        // receipts, and making them ask each traveller to type their own
        // rows means the ledger is never finished. Limited to people who are
        // actually in the split: filing money against somebody outside it
        // would credit a person the settlement never pays back.
        allow create: if request.resource.data.paise is int
          && request.resource.data.paise > 0
          && (
            (canSpend()
              && paidByCaller()
              && (request.resource.data.status == 'pending'
                  || (tripOwner()
                      && request.resource.data.status == 'approved')))
            || (tripOwner()
              && request.resource.data.by in spenders()
              && request.resource.data.status == 'approved')
          );

        // Your own row, and it stays yours -- reassigning an expense to
        // somebody else would change what they owe without their knowing.
        // The owner decides an expense's fate. Anyone else may correct their
        // own row, but cannot approve it -- the status is the one field they
        // may not touch, which is the whole point.
        //
        // A member's correction lands as 'pending' rather than keeping the
        // status it had. Requiring the status merely to be unchanged let
        // somebody have 1,000 approved and then quietly make it 10,000: the
        // settlement moved, and the owner never saw the new number. A changed
        // amount is a changed claim, so it goes back into the queue.
        // canSpend() rather than membership of the trip: the ledger has its
        // own list now, and somebody approved only for the itinerary has no
        // business correcting a row of spending.
        allow update: if tripOwner()
          || (canSpend()
              && resource.data.by == request.auth.uid
              && request.resource.data.by == resource.data.by
              && request.resource.data.status == 'pending'
              && request.resource.data.paise is int
              && request.resource.data.paise > 0);

        // The trip owner can also remove a row, so a trip is not stuck with
        // an entry from somebody who has left.
        allow delete: if signedIn()
          && (resource.data.by == request.auth.uid || tripOwner());
      }

      // The photo of a bill, one per expense, keyed by that expense's id --
      // so there is no way to have two receipts disagreeing about one row.
      //
      // In Firestore rather than Firebase Storage, which is not set up on
      // this project. The metadata lives here and the bytes in a document
      // beneath it, because a listener cannot ask for some fields and not
      // others: keeping the blob out is the only way for a screen to know
      // which rows have a receipt without downloading every one.
      match /receipts/{expenseId} {

        allow read: if signedIn();

        // Anyone in the split may attach one. It is evidence about money the
        // group shares, and a bill is not a claim about anybody's balance --
        // unlike an amount, it moves nothing, so it needs no approval.
        allow create, update: if canSpend()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.bytes is int
          && request.resource.data.bytes > 0;

        allow delete: if signedIn()
          && (resource.data.by == request.auth.uid || tripOwner());

        // The bytes themselves.
        match /image/{imageId} {

          allow read: if signedIn();

          // Capped in the rules and not only in the client.
          //
          // A document over a mebibyte is refused by Firestore with an error
          // nobody can act on, and a modified client could try to park
          // megabytes of anything in somebody else's trip. 800,000 leaves
          // room for the field names and the base64 overhead the client has
          // already paid for.
          allow create, update: if canSpend()
            && request.resource.data.by == request.auth.uid
            && request.resource.data.jpeg is string
            && request.resource.data.jpeg.size() > 0
            && request.resource.data.jpeg.size() < 800000;

          allow delete: if signedIn()
            && (resource.data.by == request.auth.uid || tripOwner());
        }
      }

      // The trip's own photos, for the reel.
      //
      // Same shape as receipts and for the same reason: metadata here, bytes
      // in a document beneath, so a screen can list a trip's photos and their
      // verdicts without downloading every image.
      match /photos/{photoId} {

        allow read: if signedIn();

        // Anyone in the trip may add a photo of it. The verdict is written
        // alongside, and `unchecked` is a real value -- a photo the filter
        // could not judge is stored as unjudged rather than as approved,
        // which is what stops a document reaching a reel when the checker is
        // down.
        allow create: if tripMemberOrOwner()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.verdict in
               ['approved', 'rejected', 'waiting', 'unchecked'];

        // Changing a verdict is a person overruling the checker, or deciding
        // about one it could not reach. Limited to the fields that carry an
        // opinion: an update may not rewrite whose photo it is, when it was
        // taken or where.
        allow update: if tripMemberOrOwner()
          && request.resource.data.by == resource.data.by
          && request.resource.data.verdict in
               ['approved', 'rejected', 'waiting', 'unchecked']
          // 'place' too: a lookup from a photograph's coordinates is a
          // guess, and the traveller correcting it is the whole point of
          // showing it to them.
          && changed().hasOnly(
               ['verdict', 'reason', 'caption', 'score', 'place']);

        allow delete: if signedIn()
          && (resource.data.by == request.auth.uid || tripOwner());

        match /image/{imageId} {

          allow read: if signedIn();

          // Capped here as well as in the client: a modified client could
          // otherwise park megabytes of anything in somebody else's trip.
          allow create, update: if tripMemberOrOwner()
            && request.resource.data.by == request.auth.uid
            && request.resource.data.jpeg is string
            && request.resource.data.jpeg.size() > 0
            && request.resource.data.jpeg.size() < 800000;

          allow delete: if signedIn()
            && (resource.data.by == request.auth.uid || tripOwner());
        }
      }

      // Who changed what in the spending, and when.
      //
      // Written alongside each change so a number cannot move without leaving
      // a line. Nobody may edit or delete one, the owner included: a history
      // that can be rewritten is not a history, and the point of this is that
      // the group can see what happened even when it was the owner who did it.
      match /history/{changeId} {

        allow read: if signedIn();

        allow create: if canSpend()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.action in
               ['added', 'edited', 'removed', 'split', 'approved', 'rejected']
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 260;

        allow update, delete: if false;
      }

      // Money one traveller has handed another, closing part of a debt.
      //
      // Separate from expenses because it is not money the group spent: filed
      // as an expense it would inflate the trip total and hand the payer a
      // share of their own repayment.
      match /payments/{paymentId} {

        allow read: if signedIn();

        // Only somebody who was actually part of it, or the owner settling
        // the group's cash. A payment invented by a third party would wipe
        // out a real debt, and it would look exactly like a genuine one.
        //
        // Both ends must be people the split pays out to: recording a payment
        // to somebody outside it would credit a person the settlement never
        // reaches.
        allow create: if canSpend()
          && request.resource.data.paise is int
          && request.resource.data.paise > 0
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.by == request.auth.uid
          && (request.resource.data.from == request.auth.uid
              || request.resource.data.to == request.auth.uid
              || tripOwner())
          && request.resource.data.from in spenders()
          && request.resource.data.to in spenders();

        // Never editable. A payment either happened or it did not, and a
        // changed amount is a different payment -- one the other party has
        // not seen. Wrong ones are removed and re-recorded, which leaves the
        // removal visible rather than silently rewriting history.
        allow update: if false;

        allow delete: if signedIn()
          && (resource.data.by == request.auth.uid || tripOwner());
      }

      match /proposals/{proposalId} {

        // Readable by anyone who can read the trip, so a contributor can see
        // that their suggestion is still waiting rather than resubmitting it.
        allow read: if signedIn();

        // Anyone signed in who has the link may suggest a change, and must
        // sign it with their own uid. Opening as anything but 'open' would
        // let somebody file a change already marked accepted.
        allow create: if signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.state == 'open'
          && request.resource.data.kind in ['add', 'remove', 'move'];

        // Only the owner decides. A contributor cannot approve their own
        // suggestion, which is the entire point of the model.
        allow update: if tripOwner();

        // Withdrawing your own suggestion is allowed; deleting someone
        // else's is not.
        allow delete: if tripOwner() || resource.data.by == request.auth.uid;
      }
    }
  }
}
