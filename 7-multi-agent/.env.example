# Google Cloud API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials

# ── AI Backend (choose one) ──────────────────────────────
# Option 1: Vertex AI (recommended for hackathon)
# Run: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option 2: Direct Gemini API (simpler for local dev)
GOOGLE_API_KEY=your_google_api_key_here

# Google Places/Maps API Key (can be same as GOOGLE_API_KEY)
GOOGLE_PLACES_API_KEY=your_google_api_key_here

# MongoDB Atlas Connection
# Get from: MongoDB Atlas → Connect → Drivers → Connection String
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/triplix
MONGODB_DB=triplix

# OpenWeatherMap API Key (Optional - for weather features)
# Get free API key from: https://openweathermap.org/api
# Note: Weather feature works with fallback data if not provided
OPENWEATHER_API_KEY=your_openweather_api_key_here
